# Copy to .env and fill in. Never commit .env.
#
# One file serves both paths: Next.js reads .env directly, and Docker Compose
# reads it for ${VAR} substitution in docker-compose.yml.
# In Portainer, enter these in the stack's "Environment variables" panel instead.

# ── Docker only ───────────────────────────────────────────────────────────────
# Host port the container publishes on. Ignored by `npm run dev`.
APP_PORT=3000

# ── MailerLite (entirely optional) ────────────────────────────────────────────
# Leave MAILERLITE_API_KEY blank to run notification-only: submissions are
# emailed via Mailgun and MailerLite is skipped, with no errors logged.
# Create at: MailerLite → Integrations → API → Generate new token
MAILERLITE_API_KEY=

# Group every submission is added to.
# Run `npm run setup:mailerlite` to list your group IDs.
MAILERLITE_GROUP_ID=

# Optional: extra group for people who answered "Yes" to volunteering.
MAILERLITE_VOLUNTEER_GROUP_ID=

# Optional: setup script creates a group with this name if it doesn't exist.
MAILERLITE_GROUP_NAME=Website Signups

# ── Mailgun ───────────────────────────────────────────────────────────────────
# Mailgun → Send → Domain settings → Sending API keys
MAILGUN_API_KEY=

# Your verified sending domain, e.g. mg.sfrlf.org
MAILGUN_DOMAIN=

# "eu" if your Mailgun account is in the EU region; otherwise leave blank/us.
MAILGUN_REGION=us

# Who gets the follow-up notification. Comma-separate for multiple recipients.
NOTIFY_TO=

# Optional. Sender shown on the notification — must be on MAILGUN_DOMAIN.
# Leave blank to use the default: forms@$MAILGUN_DOMAIN
# Example: NOTIFY_FROM=SFRLF Website <forms@mg.sfrlf.org>
NOTIFY_FROM=
